# ============================================================
# Therapy API — Local Development Defaults
# ============================================================
# These values work ONLY for local development.
# For production, override every value in the production env file.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://therapy:therapy@localhost:5433/therapy

# --- Auth ---
# Generate for production: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=dev_only_replace_in_prod_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- App ---
APP_NAME=Therapy API
APP_ENV=development
DEBUG=true
APP_URL=http://localhost:3001
ADMIN_EMAIL=admin@therapy.local

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Business rules ---
TIMEZONE=America/Argentina/Buenos_Aires
SLOT_DURATION=45
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=19:00
BUSINESS_WORK_DAYS=[0,1,2,3,4,5]
TOKEN_EXPIRY_DAYS=30

# --- Rate limits ---
BOOKING_RATE_LIMIT_REQUESTS=5
BOOKING_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_REQUESTS=3
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
AVAILABILITY_RATE_LIMIT_REQUESTS=30
AVAILABILITY_RATE_LIMIT_WINDOW_MS=60000

# --- Seed admin (scripts/seed_admin.py) ---
ADMIN_PASSWORD=local_dev_only_pw_change_me
ADMIN_NAME=Local Admin

# --- Optional integrations ---
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
