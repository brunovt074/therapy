# ============================================================
# Therapy Integrations — Local Development Defaults
# ============================================================
# Setup:
#   cp .env.example .env.local
#   make setup-local
#
# For production, create .env.prod (NEVER commit it) with real values.
# See .env.prod.example for the template.
# ============================================================

# --- Postgres ---
POSTGRES_USER=therapy
POSTGRES_PASSWORD=therapy
POSTGRES_DB=therapy
POSTGRES_PORT=5433

# --- Backend ---
BACKEND_PORT=8001

# DB connection (uses postgres service name for container-to-container)
DATABASE_URL=postgresql+asyncpg://therapy:therapy@postgres:5432/therapy

# Auth — local dev only (regenerate for prod: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=dev_only_replace_in_prod_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# App
DEBUG=true
APP_ENV=development
APP_URL=http://localhost:3001
ADMIN_EMAIL=admin@therapy.local
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# Business rules (all configurable via env)
TIMEZONE=America/Argentina/Buenos_Aires
SLOT_DURATION=45
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=19:00
BUSINESS_WORK_DAYS=[0,1,2,3,4,5]
TOKEN_EXPIRY_DAYS=30

# Rate limits
BOOKING_RATE_LIMIT_REQUESTS=5
BOOKING_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_REQUESTS=3
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
AVAILABILITY_RATE_LIMIT_REQUESTS=30
AVAILABILITY_RATE_LIMIT_WINDOW_MS=60000

# --- Admin seed (used by make seed-admin-local) ---
ADMIN_PASSWORD=local_dev_only_pw_change_me
ADMIN_NAME="Local Admin"

# --- Frontend ---
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- Caddy (prod profile only) ---
HTTP_PORT=8080
HTTPS_PORT=8443
DOMAIN=localhost

# --- Optional integrations (leave empty for local dev) ---
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
