# ============================================================
# Therapy Integrations — PRODUCTION Template
# ============================================================
# Copy to .env.prod and fill EVERY value before deploying.
# .env.prod is gitignored — NEVER commit it.
#
# Generate JWT_SECRET:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# Generate POSTGRES_PASSWORD:
#   openssl rand -base64 32
# ============================================================

# --- Postgres ---
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=therapy
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME_STRONG_PASSWORD@postgres:5432/therapy
JWT_SECRET=CHANGE_ME_USE_PYTHON_SECRETS_TOKEN_URLSAFE_48
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
DEBUG=false
APP_ENV=production
APP_URL=https://CHANGE_ME.com
ADMIN_EMAIL=CHANGE_ME@CHANGE_ME.com
CORS_ORIGINS=https://CHANGE_ME.com

# Business rules (adjust to production schedule)
TIMEZONE=America/Argentina/Buenos_Aires
SLOT_DURATION=45
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=19:00
BUSINESS_WORK_DAYS=[0,1,2,3,4,5]
TOKEN_EXPIRY_DAYS=30

# Rate limits
BOOKING_RATE_LIMIT_REQUESTS=5
BOOKING_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_REQUESTS=3
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
AVAILABILITY_RATE_LIMIT_REQUESTS=30
AVAILABILITY_RATE_LIMIT_WINDOW_MS=60000

# --- Admin seed (run ONCE during initial deploy) ---
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS
ADMIN_NAME=Production Admin

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://CHANGE_ME.com/api

# --- Caddy ---
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=CHANGE_ME.com

# --- Optional integrations ---
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
