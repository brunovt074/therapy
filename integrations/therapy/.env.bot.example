# ============================================================
# Therapy Bot Stack — Evolution API + therapy-bot-gateway (local only)
# ============================================================
# Setup:
#   cp .env.bot.example .env.bot
#   # fill in the secrets below
#   make up-bot
# ============================================================

EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_POSTGRES_DB=evolution

EVOLUTION_PORT=8085
EVOLUTION_SERVER_URL=http://localhost:8085
# Any long random string - regenerate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_API_KEY=

# therapy-mcp service account (role=admin in therapy-api).
# After filling these in: make seed-bot-local
BOT_EMAIL=bot-mcp@therapy.local
BOT_PASSWORD=
BOT_NAME="Therapy Bot"

BOT_GATEWAY_PORT=8090

# opencode serve runs on the host, not in Docker — the gateway reaches it via
# host.docker.internal. Must bind to 0.0.0.0 (not 127.0.0.1) to be reachable
# from the container, which means it MUST be password protected:
#   OPENCODE_SERVER_PASSWORD=<value below> opencode serve --hostname 0.0.0.0
OPENCODE_BASE_URL=http://host.docker.internal:4096
OPENCODE_AGENT=therapy-reception-bot
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
